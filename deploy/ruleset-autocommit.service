# Host-side autocommit loop for hestia. Runs on the HOST (not in a container) so
# it reuses the SSH key + git identity you already set up to clone/pull — no
# credential plumbing into a container.
#
# Install (paths below assume the repo at /home/chrooks/projects/chrooked-pokedex
# — edit User + the two paths if you cloned elsewhere):
#   sudo cp deploy/ruleset-autocommit.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ruleset-autocommit
[Unit]
Description=chrooked-pokedex ruleset autocommit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chrooks
WorkingDirectory=/home/chrooks/projects/chrooked-pokedex
ExecStart=/home/chrooks/projects/chrooked-pokedex/scripts/ruleset-autocommit.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
