# chrooked-pokedex — local config. Copy to `.env` and fill in your key.
# `.env` is gitignored (never commit secrets). A real environment variable always
# wins over anything set here. Loaded by the web server at startup.

# Which gen-AI provider backs the LLM-assisted authoring features (#6+).
# Provider-agnostic via LiteLLM: swap the model string to change providers, e.g.
#   anthropic/claude-sonnet-4-6   (default)
#   openai/gpt-4o
#   bedrock/anthropic.claude-3-5-sonnet-...
#   ollama/llama3                 (local, no key)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Provider API key. Use the var your provider expects:
#   Anthropic    → ANTHROPIC_API_KEY
#   OpenAI       → OPENAI_API_KEY
#   (local/Ollama needs no key)
ANTHROPIC_API_KEY=sk-ant-your-key-here
